{
  "name": "role-sc-web",
  "version": "1.0.0",
  "description": "Website (Vue 3 + Vite) do TCC Rolê SC — eventos culturais e municipais do litoral catarinense.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "deploy": "pnpm build && node scripts/deploy.mjs",
    "deploy:only": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "axios": "^1.7.9",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/ion": "^1.2.2",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.9.2",
    "unplugin-icons": "^22.0.0",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  }
}
