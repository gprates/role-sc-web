# ==========================================================================
#  Rolê SC — Web
# ==========================================================================
# Copie para `.env.local` (que está no .gitignore) e preencha.
#
# REGRA DE OURO: variáveis SEM o prefixo `VITE_` nunca entram no bundle.
# É exatamente por isso que a API key mora em `DEV_API_KEY` e não em
# `VITE_API_KEY` — ela é lida pelo proxy do dev server (Node), não pelo browser.
# ==========================================================================

# --- Desenvolvimento local ------------------------------------------------
# Para onde o proxy `/api/*` do Vite aponta.
#   backend rodando local (pnpm dev no role-sc-api): http://localhost:3000
#   API Gateway de produção: https://<id>.execute-api.sa-east-1.amazonaws.com/prod
DEV_API_TARGET=http://localhost:3000

# Valor da API key do API Gateway. O proxy do Vite injeta como header
# `x-api-key` em toda request. Deixe vazio se estiver apontando para o
# backend local (`pnpm dev` do role-sc-api não valida a chave).
# Para obter:  aws apigateway get-api-key --api-key <id> --include-value
DEV_API_KEY=

# --- Google Sign-In (fora da v1) ------------------------------------------
# Deixe VAZIO para esconder o botão "Continuar com Google".
# Quando for ligar: use o mesmo Web Client ID do app mobile e adicione
# https://role-sc.com.br e https://www.role-sc.com.br em
# "Authorized JavaScript origins" no Google Cloud Console.
VITE_GOOGLE_WEB_CLIENT_ID=

# --- Modo direto (NÃO recomendado) ----------------------------------------
# Só preencha se você NÃO for configurar o proxy /api/* no CloudFront.
# Neste modo o browser chama o API Gateway direto e a API KEY FICA EXPOSTA
# no JavaScript, legível por qualquer pessoa no DevTools.
# VITE_API_BASE_URL=https://<id>.execute-api.sa-east-1.amazonaws.com/prod
# VITE_API_KEY=

# --- Deploy (usado por scripts/deploy.mjs) --------------------------------
# Nome do bucket S3 que serve o site.
AWS_S3_BUCKET=
# ID da distribuição CloudFront, para invalidar o cache do index.html.
# Opcional: se ficar vazio, o deploy só faz o sync e avisa.
AWS_CLOUDFRONT_DISTRIBUTION_ID=
# Perfil do AWS CLI a usar (opcional).
AWS_PROFILE=
